generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  userId       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("user_id")
  email        String      @unique @db.Citext
  name         String
  passwordHash String      @map("password_hash")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz(6)
  apiTokens    ApiToken[]
  cards        Card[]
  @@map("users")
}

model ApiToken {
  tokenId    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("token_id")
  userId     String    @db.Uuid @map("user_id")
  tokenHash  String    @unique @db.Char(64) @map("token_hash")
  label      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@index([userId], map: "ix_tokens_user")
  @@map("api_tokens")
}

model Card {
  cardId       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("card_id")
  userId       String            @db.Uuid @map("user_id")
  name         String
  bank         String?
  last4        String?           @db.VarChar(4)
  creditLimit  Decimal           @map("credit_limit") @db.Decimal(12, 2)
  statementDay Int               @map("statement_day") @db.SmallInt
  dueDay       Int               @map("due_day") @db.SmallInt
  color        String?
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  statements   Statement[]
  plans        InstallmentPlan[]
  transactions Transaction[]
  @@unique([userId, name])
  @@index([userId], map: "ix_cards_user")
  @@map("cards")
}

model Category {
  categoryId   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("category_id")
  name         String        @unique
  transactions Transaction[]
  @@map("categories")
}

model Statement {
  statementId    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("statement_id")
  cardId         String        @db.Uuid @map("card_id")
  statementMonth DateTime      @map("statement_month") @db.Date
  cutoffDate     DateTime      @map("cutoff_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  totalDue       Decimal?       @map("total_due") @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paidAt         DateTime?     @map("paid_at") @db.Date
  card           Card          @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
  transactions   Transaction[]
  @@unique([cardId, statementMonth])
  @@map("statements")
}

model InstallmentPlan {
  planId              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("plan_id")
  cardId              String        @db.Uuid @map("card_id")
  itemName            String        @map("item_name")
  principal           Decimal?      @db.Decimal(12, 2)
  termCount           Int           @map("term_count") @db.SmallInt
  monthlyAmount       Decimal       @map("monthly_amount") @db.Decimal(12, 2)
  firstStatementMonth DateTime      @map("first_statement_month") @db.Date
  status              String        @default("ACTIVE")
  note                String?
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  card                Card          @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
  transactions        Transaction[]
  @@map("installment_plans")
}

model Transaction {
  txnId          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("txn_id")
  cardId         String           @db.Uuid @map("card_id")
  statementId    String?          @db.Uuid @map("statement_id")
  categoryId     String?          @db.Uuid @map("category_id")
  planId         String?          @db.Uuid @map("plan_id")
  installmentNo  Int?             @map("installment_no") @db.SmallInt
  txnType        String           @map("txn_type")
  txnDate        DateTime         @map("txn_date") @db.Date
  statementMonth DateTime         @map("statement_month") @db.Date
  description    String?
  amount         Decimal          @db.Decimal(12, 2)
  status         String           @default("POSTED")
  paidAt         DateTime?        @map("paid_at") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  card           Card             @relation(fields: [cardId], references: [cardId], onDelete: Cascade)
  statement      Statement?       @relation(fields: [statementId], references: [statementId])
  category       Category?        @relation(fields: [categoryId], references: [categoryId])
  plan           InstallmentPlan? @relation(fields: [planId], references: [planId], onDelete: Cascade)
  @@index([cardId, statementMonth], map: "ix_txn_card_stmt")
  @@index([planId], map: "ix_txn_pending")
  @@map("transactions")
}
